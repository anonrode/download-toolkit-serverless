<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AnonDownloader" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#00000000</item>
        <!-- Transparent, NOT opaque black: the app runs edge-to-edge, so an
             opaque navigationBarColor paints a solid strip over the content —
             a visible seam across the gesture area whenever the content
             behind it isn't exactly #FF000000 (the light theme, cards, etc.).
             Transparent lets the app's own background run behind the pill. -->
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- The app draws its own background behind both bars and picks icon
             colors itself (enableEdgeToEdge / syncSystemBars); the system's
             automatic contrast scrim would otherwise lay a translucent gray
             band over the nav area on API 29+. -->
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.AnonDownloader.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- The bare brand monogram glyph (user-approved "Light Surface A"),
             dynamically tinted via @color/splash_glyph_color.
             API 31+ masks the splash icon to a circle — the bare monogram reads
             cleanly without squircle clipping. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_anon_monogram</item>
        <item name="postSplashScreenTheme">@style/Theme.AnonDownloader</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.AnonDownloader.Dialog" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
