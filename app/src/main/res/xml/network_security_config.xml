<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is locked down globally; only the legacy locker hosts that
  still serve http:// links are allowed to use it. Everything else must
  use HTTPS. (MITM surface: an ISP/rogue AP can only tamper with these
  few hosts' traffic, not with every page the app fetches.)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">downloadwella.com</domain>
        <domain includeSubdomains="true">wetafiles.com</domain>
        <domain includeSubdomains="true">loadedfiles.net</domain>
        <domain includeSubdomains="true">loadedfiles.st</domain>
        <domain includeSubdomains="true">loadedfiles.to</domain>
        <domain includeSubdomains="true">loadedfiles.org</domain>
        <domain includeSubdomains="true">loadedfiles.com</domain>
        <domain includeSubdomains="true">kissorgrab.com</domain>
        <!-- Telemetry sink: plain-HTTP raw-IP on a nonstandard port; the OTA
             rules carry remote_logging_url on this host and every prior
             upload died at the network layer without this exemption
             (CleartextNotPermitted). Only this address is exempted. -->
        <domain includeSubdomains="false">68.155.146.145</domain>
    </domain-config>
</network-security-config>
