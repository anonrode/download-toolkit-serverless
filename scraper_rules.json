{
  "version": "2026.08.22.2",
  "domains": {
    "nkiri": "https://thenkiri.com",
    "dramakey": "https://dramakey.com",
    "asianc": "https://asianc.id",
    "anitaku": "https://anitaku.com.ro",
    "pluto": "https://plutomovies.com",
    "dramarain": "https://dramarain.com",
    "9jarocks": "https://9jarocks.net",
    "naijavault": "https://www.naijavault.com",
    "naijaprey": "https://www.naijaprey.tv",
    "nepu": "https://nepu.gd",
    "torrents": "https://apibay.org"
  },
  "sites": {
    "pluto": {
      "searchPattern": "/search/{query}/page/1",
      "searchType": "html",
      "cardSelector": "a[href*='/movie/'], a[href*='/series/']",
      "seriesDescentSelectors": [
        "a[href*='/series/'], a[href*='/season']",
        "a[href*='dl.plutomovies.com']"
      ],
      "downloadAnchorSelector": "a[href*='dl.plutomovies.com']",
      "episodeSelector": "a[href*='dl.plutomovies.com'], a[href*='/series/']"
    },
    "9jarocks": {
      "searchPattern": "/search/{query}/feed/rss2/",
      "searchType": "rss",
      "cardSelector": "item",
      "episodeSelector": "a[href*='loadedfiles'], a[href*='downloadwella'], a[href*='wetafiles'], a[href*='.mkv'], a[href*='.mp4']"
    },
    "naijavault": {
      "searchPattern": "/wp-json/wp/v2/posts?search={query}&_embed=1",
      "searchType": "json",
      "episodeSelector": "a[href*='nkiserv'], a[href*='filevault'], a[href*='downloadwella'], a[href*='wetafiles'], a[href*='loadedfiles'], a[href*='.mkv'], a[href*='.mp4'], a[href*='/dl-'], a[href*='gtoddl'], a[href*='wapkizfile']"
    },
    "asianc": {
      "searchPattern": "/api?a=search&keyword={query}",
      "searchType": "json",
      "cardSelector": "data",
      "episodeSelector": "ul.list-episode-item-2 li a, .all-episodes li a, .list-episode a, .list-episode-item a, a[href*='-episode-']"
    },
    "dramarain": {
      "searchPattern": "/?s={query}",
      "searchType": "html",
      "cardSelector": "article, .film-item, a[href*='-drama']",
      "episodeSelector": "a[href*='/download?link='], a[href*='wetafiles.com'], a[href*='downloadwella.com'], a[href*='loadedfiles.']",
      "slugSuffixes": [
        "",
        "-chinese-drama",
        "-thai-drama",
        "-japanese-drama",
        "-philippines-drama",
        "-korean-drama",
        "-season-1"
      ]
    },
    "naijaprey": {
      "searchPattern": "/search/{query}/feed/rss2/",
      "searchType": "rss",
      "cardSelector": "item",
      "episodeSelector": "a[href*='vdl.'], a[href*='sdm.'], a[href*='wildshare'], a[href*='downloadwella'], a[href*='waffi'], a[href*='loadedfiles']"
    }
  },
  "resolvers": {
    "loadedfiles": {
      "tokenRegex": "var\\s+downloadUrl\\s*=\\s*'([^']+)'",
      "maxRedirectHops": 4
    },
    "downloadwella": {
      "tokenRegex": "href=[\"'](https?://[^\"']+\\.(?:mkv|mp4|avi|zip|rar)[^\"']*)[\"']",
      "formActionSelector": "form"
    }
  },
  "directMediaExtensions": [
    ".mp4",
    ".mkv",
    ".webm",
    ".avi",
    ".ts",
    ".m3u8",
    ".m4v",
    ".mp3",
    ".zip",
    ".rar",
    "-mp4",
    "-mkv"
  ],
  "dynamic_providers": []
}