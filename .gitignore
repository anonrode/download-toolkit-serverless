# Built binaries & packages
*.apk
*.aab
*.dex
*.class

# Gradle & Android build output (HUGE token/LSP consumers)
.gradle/
build/
app/build/
.cxx/
.externalNativeBuild/
captures/

# IDE & OS caches
.idea/
.vscode/
*.iml
.DS_Store
local.properties

# Logs & temp files
*.log
*.tmp
probe/results-*.jsonl
.ci-logs/
__pycache__/
*.pyc

# OTA rules plaintext stays local — only the encrypted payload is committed
scraper_rules.json
# plain-text playbook probe dumps (same sensitivity as scraper_rules.json)
ota_plain_probe.json
probe/results-nightly/

# Local investigation artifacts (never publish)
.agents/
scratch/
ORIGINAL_REQUEST.md
probe/*_audit_results.json
probe/*_audit.py

# ── go-public hardening (2026-10-15): internal docs stay local, never tracked ──
.agents/
scratch/
probe/
ORIGINAL_REQUEST.md
Anon Road Pre-launch Document.md
HANDOVER.md
HANDOVER_AUDIT.md
MASTER_ISSUES_AND_COMPLAINTS_NOTEBOOK.md
REVIEW_PROMPTS.md

# signing material never enters the tree
*.jks
*.keystore
*.p12
*.pem
anon-release.*
NUL
